# syntax=docker/dockerfile:1.7

# Exact patch versions are intentional. The frontend is built once and served as static assets;
# Node is not present in the runtime image.
FROM node:24.20.0-alpine3.24 AS build

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    VITE_BROWSER_AUTH_ENABLED=true

WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig*.json vite.config.ts index.html ./
COPY src ./src
RUN npm run build

FROM caddy:2.11.4-alpine AS runtime

WORKDIR /srv
COPY Caddyfile.production /etc/caddy/Caddyfile
COPY --from=build /build/dist /srv

EXPOSE 8080

# Railway supplies PORT. The Caddyfile defaults to 8080 for container-level reproduction.
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
