:{$PORT:8080} {
    encode zstd gzip

    # Browser authentication stays on the product origin. Neon Auth remains the managed session
    # authority, but cookies are issued through this reverse-proxy boundary so the browser never
    # needs cross-origin tenant/API credentials.
    #
    # Caddy normally forwards the original public X-Forwarded-Host. Managed Neon Auth treats
    # forwarded host/proto as server-identity inputs, which caused it to canonicalize the rewritten
    # upstream path back onto the public hostname (HTTP 308 /academy_tractian/auth/*). Pin both Host
    # and X-Forwarded-Host to the trusted managed-auth upstream. The browser Origin header remains
    # untouched and continues to drive Better Auth trusted-origin / CSRF checks.
    handle_path /auth/* {
        rewrite * {$NEON_AUTH_BASE_PATH:/academy_tractian/auth}{uri}
        reverse_proxy https://{$NEON_AUTH_HOST} {
            header_up Host {$NEON_AUTH_HOST}
            header_up X-Forwarded-Host {$NEON_AUTH_HOST}
            header_up X-Forwarded-Proto https
        }
    }

    # Keep API and SSE browser traffic same-origin. Railway private networking carries the
    # service-to-service hop; no public API URL is required by the browser for normal product use.
    @backend path /api/* /health
    handle @backend {
        reverse_proxy http://production-api.railway.internal:8000 {
            # Explicitly disable response buffering so Server-Sent Events are forwarded live.
            flush_interval -1
        }
    }

    # SPA fallback: real static files win, otherwise route to index.html.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}
