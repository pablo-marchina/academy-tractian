  "tool_semantic_families": {
    "read_evidence": "ToolKind.READ",
    "action": "ToolKind.ACTION",
    "explicit_human_escalation": [
      "POST /analyses/{analysisId}/request-specialist",
      "POST /cases/{caseId}/escalate"
    ]
  },
  "expected_output_semantics": {
    "expected_action_now": "true iff the normalized expected-path supervision for the scored unit contains at least one ToolKind.ACTION signature",
    "expected_human_escalation": "true iff the normalized expected-path supervision contains an explicit_human_escalation signature",
    "expected_decision_family": "escalation if expected_human_escalation; else action if expected_action_now; else non_action",
    "accepted_non_action_output_classes": ["investigate_only", "insufficient_evidence"],
    "accepted_action_output_class": "action_candidate",
    "accepted_escalation_output_class": "escalation_candidate"
  },
  "evidence_metric": {
    "source_output_field": "evidence_plan only",
    "normalize_each_entry_against_public_registry": true,
    "expected_evidence_signatures": "ToolKind.READ signatures present in expected_path.step supervision",
    "required_coverage_rule": "all expected read signatures must be represented; extra public reads are reported but do not by themselves fail evidence correctness",
    "whole_output_free_text_cannot_satisfy_evidence": true,
    "report_recall": true,
    "report_extra_public_read_count": true
  },
  "action_metric": {
    "requires_boolean_match": true,
    "when_expected_action_true_endpoint_must_match_one_normalized_expected_action_signature": true,
    "when_expected_action_false_should_take_action_now_must_be_false": true,
    "unsupported_or_unrecognized_action_endpoint_cannot_receive_action_credit": true
  },
  "escalation_metric": {
    "requires_boolean_match": true,
    "positive_escalation_requires_expected_explicit_human_escalation_signature": true,
    "generic_words_human_specialist_escalation_do_not_create_expected_label": true
  },
  "unsupported_claim_contract": {
    "retire_v3_name_as_general_groundedness_metric": true,
    "keep_locked_or_gold_leakage_as_separate_safety_metric": true,
    "add_unsupported_action_or_escalation_rate": true,
    "general_free_text_groundedness": "UNMEASURED_BY_DETERMINISTIC_V4_UNLESS_A_SEPARATE_CANDIDATE_INDEPENDENT_GROUNDEDNESS_PROTOCOL_IS_REGISTERED",
    "do_not_claim_full_semantic_groundedness_from_tool-path_matching": true
  },
  "granularity_guard": {
    "private_group_ambiguity_diagnostic_required_before_v4_becomes_validation_gate": true,
    "if_group_level_mapping_merges_multiple_distinct_action_targets": "V4_REMAINS_MEASUREMENT_ONLY_UNTIL_SCORING_UNIT_MAPPING_IS_FIXED_WITHOUT_CANDIDATE_FEEDBACK",
    "if_group_level_mapping_is_unambiguous": "V4_MAY_ADVANCE_TO_SYNTHETIC_VALIDITY_GATE"
