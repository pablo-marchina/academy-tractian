    "validation_feedback_seen": false,
    "locked_test_feedback_seen": false
  },
  "normalization": {
    "authoritative_public_registry": "research/e2/tool_registry.py",
    "oracle_semantic_source": "expected_path.step only",
    "ignore_root_question_for_labels": true,
    "ignore_mode_for_action_escalation_labels": true,
    "normalize_http_method": true,
    "normalize_concrete_ids_and_placeholder_spelling_to_registry_path_template": true,
    "ignore_step_order_for_initial_v4_set_metrics": true,
    "notes_do_not_create_new_tool_signatures": true,
    "notes_may_not_flip_a_step_into_action_or_escalation_without_a_separate_scope-aware rule": true
