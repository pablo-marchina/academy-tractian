{
  "schema_version": "e6-live-api-integration-continuation-v1",
  "id": "E6-live-api-langgraph-continuation",
  "date": "2026-08-16",
  "status": "PREREGISTERED",
  "purpose": "Replace the E6 deterministic stub transport with the live supplied API transport surface while preserving B3, evidence-sufficiency, split isolation and comparator retention.",
  "scope": {
    "allowed_splits": [
      "DEV",
      "VALIDATION"
    ],
    "forbidden_splits": [
      "LOCKED_TEST"
    ],
    "locked_test_accessed": false
  },
  "constants": {
    "runtime_candidate": "LangGraph",
    "execution_boundary": "HarnessRunner",
    "transport": "HttpxTransport",
    "tool_contract_source": "research.e2.tool_registry.TOOLS",
    "boundary_candidate": "B3",
    "stopping_policy_candidate": "evidence_sufficiency_policy",
    "identity_binding": "runner",
    "seed_binding": "runner",
    "model_provider_freeze": false,
    "mcp_topology_freeze": false,
    "rag_freeze": false,
    "multi_agent_freeze": false,
    "ui_freeze": false
  },
  "representative_groups": {
    "DEV": [
      "asset_G501",
      "asset_C710"
    ],
    "VALIDATION": [
      "asset_B204",
      "asset_M102"
    ]
  },
  "model_proposal_generation": {
    "allowed_inputs": [
      "agent-input/cases.json",
      "docs/api-contract.openapi.yaml",
      "runtime live API observations"
    ],
    "forbidden_inputs": [
      "eval/expected-paths.json",
      "eval/test-scenarios.md",
      "docs/test-scenarios.md",
      "data/cases.parquet",
      "LOCKED_TEST cases"
    ],
    "gold_leakage_guard_required": true,
    "provider_freeze": false,
    "proposal_source_class": "safe_agent_input_proposal_generator_or_external_model_proposal_file"
  },
  "required_checks": [
    "live_api_transport_is_HttpxTransport",
    "HarnessRunner_executes_tool_proposals",
    "B3_policy_check_events_present_for_actions",
    "evidence_sufficiency_policy_node_present",
    "RunTrace_compatible_output",
    "DEV_and_VALIDATION_only",
    "LOCKED_TEST_blocked",
    "proposal_generation_rejects_evaluator_only_paths",
    "latency_measured_when_live_api_available"
  ],
  "comparators_retained": [
    "pydantic_ai_graph",
    "openai_agents_sdk"
  ],
  "ci_policy": {
    "contract_mode_allowed_without_private_api_package": true,
    "live_mode_requires_api_base_url": true,
    "live_mode_requires_agent_input_cases": true,
    "contract_mode_is_not_task_success_evidence": true
  },
  "success_interpretation": {
    "contract_pass": "implementation wiring and leakage guards are valid, but live endpoint was not exercised",
    "live_pass": "DEV/VALIDATION representative cases executed through supplied API transport with RunTrace-compatible output",
    "not_final_architecture_freeze": true
  }
}
