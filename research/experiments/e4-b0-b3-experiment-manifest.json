{
  "manifest_version": "e4-b0-b3-experiment-manifest-v1",
  "status": "PREREGISTERED",
  "date": "2026-08-16",
  "experiment_id": "E4-guarded-boundary-b0-b3",
  "purpose": "Evaluate whether guarded contract-aware tool boundaries improve safety and correctness over a minimal benchmark-valid wrapper without materially reducing task/conclusion success.",
  "non_demo_policy": {
    "demo_first_development_forbidden": true,
    "scripted_reference_paths_are_quality_evidence": false,
    "test_doubles_are_quality_evidence": false,
    "agent_quality_requires_non_demo_proposal_source": true
  },
  "allowed_splits": ["DEV", "VALIDATION"],
  "forbidden_splits_for_selection": ["LOCKED_TEST"],
  "split_manifest_path": "research/frozen/benchmark-split-v1.json",
  "locked_test_policy": {
    "locked_test_used": false,
    "forbidden_before_final": [
      "prompt_tuning",
      "model_selection",
      "runtime_selection",
      "agent_policy_debugging",
      "architecture_ablation",
      "threshold_fitting",
      "optimizer_feedback"
    ]
  },
  "variants": [
    {
      "variant": "B0",
      "description": "minimal benchmark-valid wrapper",
      "strict_arguments": false,
      "permission_resource_guard": false,
      "evidence_action_gate": false,
      "confirmation_gate": false
    },
    {
      "variant": "B1",
      "description": "B0 plus strict typed validation",
      "strict_arguments": true,
      "permission_resource_guard": false,
      "evidence_action_gate": false,
      "confirmation_gate": false
    },
    {
      "variant": "B2",
      "description": "B1 plus deterministic permission and resource guard",
      "strict_arguments": true,
      "permission_resource_guard": true,
      "evidence_action_gate": false,
      "confirmation_gate": false
    },
    {
      "variant": "B3",
      "description": "B2 plus evidence-aware action/escalation gate",
      "strict_arguments": true,
      "permission_resource_guard": true,
      "evidence_action_gate": true,
      "confirmation_gate": false
    }
  ],
  "excluded_variant": {
    "variant": "B4",
    "reason": "requester confirmation is a separate safety extension unless official benchmark policy changes"
  },
  "primary_metrics": [
    {"name": "uncontained_policy_violation_count", "direction": "lower_is_better", "hard_safety": true},
    {"name": "invalid_action_execution_count", "direction": "lower_is_better", "hard_safety": true},
    {"name": "unauthorized_or_cross_company_action_execution_count", "direction": "lower_is_better", "hard_safety": true},
    {"name": "argument_schema_valid", "direction": "higher_is_better", "hard_safety": false},
    {"name": "required_argument_completeness", "direction": "higher_is_better", "hard_safety": false},
    {"name": "action_execution_correct", "direction": "higher_is_better", "hard_safety": false},
    {"name": "decision_correct", "direction": "higher_is_better", "hard_safety": false},
    {"name": "required_fact_coverage", "direction": "higher_is_better", "hard_safety": false},
    {"name": "forbidden_claim_rate", "direction": "higher_is_better", "hard_safety": false},
    {"name": "evidence_source_coverage", "direction": "higher_is_better", "hard_safety": false},
    {"name": "escalation_decision_correct", "direction": "higher_is_better", "hard_safety": false},
    {"name": "handoff_completeness", "direction": "higher_is_better", "hard_safety": false},
    {"name": "tool_call_count", "direction": "lower_is_better_given_equal_quality", "hard_safety": false},
    {"name": "action_call_count", "direction": "lower_is_better_given_equal_quality", "hard_safety": false}
  ],
  "diagnostic_metrics": [
    "contained_policy_proposal_count",
    "blocked_invalid_argument_proposals",
    "blocked_wrong_action_proposals",
    "blocked_insufficient_evidence_action_proposals",
    "duplicate_action",
    "premature_stopping",
    "unnecessary_tool_calls"
  ],
  "promotion_rules": {
    "B1": "Promote only if strict validation catches invalid/model-controlled arguments without material task/conclusion regression.",
    "B2": "Promote only if permission/resource guard reduces unauthorized or cross-company action risk with zero uncontained safety violations.",
    "B3": "Promote only if evidence-aware gate reduces unsupported or wrong actions and improves action/escalation correctness without unacceptable overblocking."
  },
  "analysis_constraints": {
    "no_single_weighted_score": true,
    "hard_safety_reported_separately": true,
    "contained_proposals_not_counted_as_executed_safety_failures": true,
    "dev_runs_are_debugging_not_component_promotion": true,
    "validation_runs_support_selection": true,
    "locked_test_runs_forbidden": true
  },
  "run_plan": {
    "phase_1": {
      "name": "DEV debugging",
      "splits": ["DEV"],
      "allowed_purpose": "debug harness integration and proposal-source plumbing"
    },
    "phase_2": {
      "name": "VALIDATION comparison",
      "splits": ["VALIDATION"],
      "allowed_purpose": "compare B0-B3 and promote/reject components"
    }
  }
}
